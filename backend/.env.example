# Copie para .env e ajuste conforme necessário.
# O .env não é versionado.

# Banco de dados. Padrão: SQLite no arquivo backend/dados.db
# Para Postgres:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/planejamento
# DATABASE_URL=sqlite:///./dados.db

# Origens liberadas no CORS (lista JSON).
# Em produção, restrinja ao domínio real do frontend.
# CORS_ORIGINS=["http://localhost:5173"]

# OBRIGATÓRIO em produção: assina os tokens de sessão.
# Sem isto, a chave é sorteada a cada inicialização e toda reinicialização
# desloga todo mundo. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=cole-aqui-o-valor-gerado

# Validade da sessão em horas. Padrão: 720 (30 dias).
# TOKEN_EXPIRA_HORAS=720
